node_modules/
dist/
.DS_Store
*.log
status.html

# Regenerate these; don't commit them.
shots/
sweeps/
profiles/

# Machine state. Mostly scratch — but these three are the run's integrity record and
# MUST be committed. They are how a fresh clone knows what every round scored, that the
# ratchet was never quietly loosened, and how far the climb got.
.anvil/*
!.anvil/state.json
!.anvil/instruments.json

# The reference IS the bar. If it moves between rounds, no two scores in the run are
# comparable. Committed on purpose.
!reference/
!reference/**

# The anchor set is the drift instrument. If these move, drift becomes undetectable.
!anchors/
!anchors/**
